# IncidentOps local configuration template. Copy to `.env` and replace values.
# Never commit real secrets. Every value below is a placeholder for local labs.

# Control-plane PostgreSQL (authoritative workflow store).
INCIDENTOPS_CONTROL_DATABASE_URL=postgresql+psycopg://incidentops:change-me@localhost:5433/incidentops_control

# Deployment profile: dev | benchmark | demo. Production remediation is unsupported.
INCIDENTOPS_PROFILE=dev

# Service identity tokens. Each process receives ONLY its own token.
INCIDENTOPS_ALERTMANAGER_TOKEN=change-me-alertmanager-identity
INCIDENTOPS_EXECUTOR_TOKEN=change-me-executor-identity
INCIDENTOPS_VERIFIER_TOKEN=change-me-verifier-identity
INCIDENTOPS_AGENT_TOKEN=change-me-agent-identity

# Fault Lab controller tokens (benchmark controller only, never the agent).
FAULT_LAB_BENCHMARK_TOKEN=change-me-benchmark
FAULT_LAB_EXECUTOR_TOKEN=change-me-executor
FAULT_LAB_READ_TOKEN=change-me-read
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Investigation agent (read-only). Set a model ID explicitly; it is recorded per run.
INCIDENTOPS_MODEL_ID=
INCIDENTOPS_ANTHROPIC_API_KEY=
# Must equal FAULT_LAB_READ_TOKEN (same placeholder => same generated value).
INCIDENTOPS_LAB_READ_TOKEN=change-me-read
INCIDENTOPS_ENDPOINT_OVERRIDES={"persist-demo-consumer": "http://127.0.0.1:18081"}
